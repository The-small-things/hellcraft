		"main": [
			"net.thesmallthings.hellcraft.HellcraftMod"
		],
		"client": [
			"net.thesmallthings.hellcraft.client.HellcraftClient"
		]
	},
	"mixins": [
		"hellcraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
